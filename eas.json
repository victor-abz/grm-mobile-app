{
  "cli": {
    "version": ">= 3.13.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": true
      },
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_FRAPPE_BASE_URL": "https://egrm.risa.gov.rw",
        "EXPO_PUBLIC_DEFAULT_LANGUAGE": "rw"
      }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "internal",
        "simulator": false
      },
      "channel": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_FRAPPE_BASE_URL": "https://egrm.risa.gov.rw",
        "EXPO_PUBLIC_DEFAULT_LANGUAGE": "rw"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "internal",
        "simulator": false
      },
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_FRAPPE_BASE_URL": "https://egrm.risa.gov.rw",
        "EXPO_PUBLIC_DEFAULT_LANGUAGE": "rw"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
